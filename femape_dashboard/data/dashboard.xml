<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dashboard_group_femape" model="spreadsheet.dashboard.group">
        <field name="name">FEMAPE</field>
        <field name="sequence">1</field>
    </record>

    <record id="dashboard_femape_ingresos_egresos" model="spreadsheet.dashboard">
        <field name="name">Ingresos y Egresos</field>
        <field name="spreadsheet_binary_data" type="base64" file="femape_dashboard/data/files/femape_ingresos_egresos.osheet.json"/>
        <field name="dashboard_group_id" ref="dashboard_group_femape"/>
        <field name="group_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/>
        <field name="sequence">10</field>
        <field name="is_published" eval="True"/>
    </record>

    <record id="dashboard_femape_impuestos_resultado" model="spreadsheet.dashboard">
        <field name="name">Impuestos y Resultado</field>
        <field name="spreadsheet_binary_data" type="base64" file="femape_dashboard/data/files/femape_impuestos_resultado.osheet.json"/>
        <field name="dashboard_group_id" ref="dashboard_group_femape"/>
        <field name="group_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/>
        <field name="sequence">20</field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="dashboard_femape_cuota_social" model="spreadsheet.dashboard">
        <field name="name">Cuota Social</field>
        <field name="spreadsheet_binary_data" type="base64" file="femape_dashboard/data/files/femape_cuota_social.osheet.json"/>
        <field name="dashboard_group_id" ref="dashboard_group_femape"/>
        <field name="group_ids" eval="[Command.link(ref('account.group_account_invoice'))]"/>
        <field name="sequence">30</field>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
