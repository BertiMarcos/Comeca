        "C1": "=CONCATENATE(IF($B$1<0,\"-$\",\"$\"),IF(ABS($B$1)>=1000000000,TEXT(ABS($B$1)/1000000,\"#,##0\"),TEXT(ABS($B$1)/1000000,\"#,##0.0\")),\" M\")",
        "C2": "=CONCATENATE(TEXT(B2/1000000,\"#,##0\"),\" M IOMA · \",TEXT(B9/1000000,\"#,##0\"),\" M socios\")",
        "C3": "=CONCATENATE(IF($B$3<0,\"-$\",\"$\"),IF(ABS($B$3)>=1000000000,TEXT(ABS($B$3)/1000000,\"#,##0\"),TEXT(ABS($B$3)/1000000,\"#,##0.0\")),\" M\")",
        "C4": "=CONCATENATE(IF($B$4<0,\"-$\",\"$\"),IF(ABS($B$4)>=1000000000,TEXT(ABS($B$4)/1000000,\"#,##0\"),TEXT(ABS($B$4)/1000000,\"#,##0.0\")),\" M\")",
        "C5": "=CONCATENATE(IF($B$5<0,\"-$\",\"$\"),IF(ABS($B$5)>=1000000000,TEXT(ABS($B$5)/1000000,\"#,##0\"),TEXT(ABS($B$5)/1000000,\"#,##0.0\")),\" M\")",
        "C6": "=CONCATENATE(IF($B$6<0,\"-$\",\"$\"),IF(ABS($B$6)>=1000000000,TEXT(ABS($B$6)/1000000,\"#,##0\"),TEXT(ABS($B$6)/1000000,\"#,##0.0\")),\" M\")",
        "C7": "=CONCATENATE(IF($B$7<0,\"-$\",\"$\"),IF(ABS($B$7)>=1000000000,TEXT(ABS($B$7)/1000000,\"#,##0\"),TEXT(ABS($B$7)/1000000,\"#,##0.0\")),\" M\")",
